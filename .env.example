# Copiar a .env.local y completar. NUNCA commitear .env.local

# Supabase (runtime de Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para scripts de administración (seed:users, migrate:users). No usar en el runtime.
SUPABASE_SECRET_KEY=
TEMP_PASSWORD=

# Roles (opcionales; estos son los valores por defecto)
READONLY_VISIT_ROLE_NAME=Registro y calendario
FULL_VISIT_ACCESS_ROLE_NAMES=Admin,Administrador
